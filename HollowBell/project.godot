; Hollow Bell - standalone medieval HD-2D adventure.
config_version=5

[application]
config/name="钟誓 · Hollow Bell"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="第一关：雾鸦隘口。An original medieval HD-2D adventure."

[display]
window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.048, 0.057, 1)
lights_and_shadows/directional_shadow/size=4096
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=24.0